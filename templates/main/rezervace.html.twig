{% extends 'base.html.twig' %}

{% block title %}Rezervace – Paddleboardy{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/rezervace.css') }}">
{% endblock %}

{% block body %}
    <section class="auth-dual-section">
        <div class="container-main">

            <h1 style="color: white; margin-bottom: 30px; font-weight: 800;">Nová rezervace</h1>

            <form action="{{ path('zpracovat_rezervaci') }}" method="POST" class="reservation-grid">
                <div class="booking-section">

                    <div class="booking-card fade-in">
                        <h3>Kdy a kde?</h3>
                        <div class="form-group">
                            <label class="form-label">Vyber lokalitu</label>
                            <select class="form-input" id="location-select" name="stanice_id">
                                {% for stanice_item in stanice %}
                                    <option value="{{ stanice_item.id }}">{{ stanice_item.nazev }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="form-row-split">
                            <div>
                                <label class="form-label">Datum</label>
                                <input type="date" class="form-input" name="datum" id="date-select">
                            </div>
                            <div>
                                <label class="form-label">Čas začátku</label>
                                <select class="form-input" name="cas" id="time-select">
                                    <option>08:00</option>
                                    <option>09:00</option>
                                    <option>10:00</option>
                                    <option>11:00</option>
                                    <option>12:00</option>
                                    <option>13:00</option>
                                    <option>14:00</option>
                                    <option>15:00</option>
                                    <option>16:00</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="booking-card fade-in">
                        <h3>Výběr setu</h3>
                        <div class="form-group">
                            <label class="form-label">Na jak dlouho?</label>
                            <select class="form-input" id="hours-select" name="hodiny">
                                <option value="1">1 hodina</option>
                                <option value="2">2 hodiny</option>
                                <option value="3">3 hodiny</option>
                                <option value="4">4 hodiny</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label class="form-label">Vyber vybavení (můžeš vybrat více)</label>

                            <div class="package-grid" id="dostupne-produkty-container">
                                <p style="color: #6c757d; font-size: 14px; text-align: center; width: 100%;">
                                    Načítám dostupné vybavení...
                                </p>
                            </div>

                        </div>
                    </div>
                </div>

                <div class="sticky-sidebar">
                    <h3 style="color: var(--color-primary); margin-bottom: 20px;">Souhrn rezervace</h3>
                    <div class="summary-row">
                        <span id="summary-location">Máchovo jezero</span>
                    </div>
                    <div class="summary-row">
                        <span id="summary-date">Dnes</span>
                        <span id="summary-time">09:00</span>
                    </div>
                    <div style="margin: 20px 0; border-top: 1px dashed #ced4da;"></div>
                    <div class="summary-row">
                        <span style="font-weight: 600;" id="summary-produkty">
                            <span style="color: #adb5bd;">Žádný produkt vybrán</span>
                        </span>
                    </div>
                    <div class="summary-total">
                        <span>Celkem</span>
                        <span id="total-price">0 Kč</span>
                    </div>
                    <button type="submit" class="cta-button" style="width:100%;border:none;margin-top:20px;font-size:16px;cursor:pointer;">
                        Pokračovat k platbě
                    </button>
                    <p style="text-align:center;font-size:12px;color:#adb5bd;margin-top:15px;">
                        <i class="fa-solid fa-lock"></i> Bezpečná platba kartou
                    </p>
                </div>
            </form>
        </div>
        <svg aria-hidden="true" viewBox="0 0 1440 120" preserveAspectRatio="none" class="wave-auth">
            <path d="M0,64 C240,160 480,0 720,64 960,128 1200,32 1440,96 L1440,120 L0,120 Z"></path>
        </svg>
    </section>
{% endblock %}

{% block javascripts %}
    <script>
        const hoursSelect = document.getElementById('hours-select');
        const locationSelect = document.getElementById('location-select');
        const container = document.getElementById('dostupne-produkty-container');

        hoursSelect.addEventListener('change', prepocitejCenu);
        locationSelect.addEventListener('change', stahniProduktyZeServeru);

        function stahniProduktyZeServeru() {
            const staniceId = locationSelect.value;
            if (!staniceId) return;

            container.innerHTML = '<p>Načítám dostupné vybavení...</p>';

            const urlSablona = "{{ path('api_stanice_vybaveni', {id: '999'}) }}";
            const finalniUrl = urlSablona.replace('999', staniceId);

            fetch(finalniUrl)
                .then(odpoved => odpoved.json())
                .then(data => {

                    if (data.length === 0) {
                        container.innerHTML = '<p style="color: red;">V této lokalitě není nic skladem.</p>';
                        prepocitejCenu();
                        return;
                    }

                    let vykresleneHtml = '';

                    data.forEach(polozka => {
                        vykresleneHtml += `
                        <div class="package-card" data-cena="${polozka.cena}" onclick="kliknutiNaKartu(this)">
                            <input type="checkbox" name="skladova_polozka_ids[]" value="${polozka.skladova_polozka_id}" style="display:none;">
                            <div class="package-info">
                                <h4>${polozka.nazev}</h4>
                                <p>${polozka.popis}</p>
                                <small style="color: green;">Skladem: ${polozka.mnozstvi} ks</small>
                            </div>
                            <div class="package-price">${polozka.cena} Kč/hod</div>
                        </div>
                    `;
                    });

                    container.innerHTML = vykresleneHtml;
                    prepocitejCenu();
                });
        }

        function kliknutiNaKartu(kartaElement) {
            const checkbox = kartaElement.querySelector('input[type="checkbox"]');
            checkbox.checked = !checkbox.checked;
            kartaElement.classList.toggle('active', checkbox.checked);
            prepocitejCenu();
        }

        function prepocitejCenu() {
             const vybraneKarty = document.querySelectorAll('.package-card.active');
            const pocetHodin = parseInt(hoursSelect.value) || 1;

            let celkovaCena = 0;
            let htmlSouhrn = '';

            vybraneKarty.forEach(karta => {
                const nazev = karta.querySelector('h4').textContent;
                const cena = parseFloat(karta.getAttribute('data-cena'));

                celkovaCena += cena;

                htmlSouhrn += `<div style="display:flex; justify-content:space-between; margin-bottom:8px;">
                              <span>${nazev}</span>
                              <span>${cena} Kč</span>
                           </div>`;
            });

            if (vybraneKarty.length === 0) {
                document.getElementById('summary-produkty').innerHTML = '<span style="color: gray;">Žádný produkt vybrán</span>';
            } else {
                document.getElementById('summary-produkty').innerHTML = htmlSouhrn;
            }

            document.getElementById('total-price').textContent = (celkovaCena * pocetHodin) + ' Kč';

            document.getElementById('summary-location').textContent = locationSelect.options[locationSelect.selectedIndex].text;
        }

        stahniProduktyZeServeru();

    </script>
{% endblock %}
