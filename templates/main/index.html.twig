{% extends 'base.html.twig' %}

{% block title %}Paddleboard Půjčovna – Rezervace Online{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/index.css') }}">
{% endblock %}

{% block body %}

    <section id="hero">
        <div class="video-background"></div>
        <div class="hero-content">
            <h1>Půjč si paddleboard kdykoli.<br>Bez obsluhy, za pár kliků.</h1>
            <p>Vyber lokaci, zaplať online a otevři box mobilem.</p>
            <a href="{{ path('rezervace') }}" class="cta-button" style="padding: 16px 32px; font-size: 18px;">Rezervovat hned</a>
            <div class="trust-metrics">
                <div class="metric"><span class="icon">✓</span> 24/7 přístup</div>
                <div class="metric"><span class="icon">✓</span> 2 min od vody</div>
                <div class="metric"><span class="icon">✓</span> Pojištěné vybavení</div>
                <div class="metric"><span class="icon">✓</span> Bez papírů</div>
            </div>
        </div>
        <svg aria-hidden="true" viewBox="0 0 1440 120" preserveAspectRatio="none" class="wave">
            <path d="M0,64 C240,160 480,0 720,64 960,128 1200,32 1440,96 L1440,120 L0,120 Z"></path>
        </svg>
    </section>

    <section id="how" class="section-light">
        <div class="container-main">
            <div class="section-header fade-in">
                <span class="section-label">Jak to funguje</span>
                <h2>Tři kroky k dokonalému dobrodružství</h2>
                <p class="section-subtitle">Celý proces zabere jen pár minut.</p>
            </div>
            <div class="steps-grid">
                <div class="step-card fade-in">
                    <div class="step-number">1</div>
                    <h3>Vyber si set a termín</h3>
                    <p>Na mapě si najdi nejbližší lokalitu a vyber si čas, kdy chceš vyrazit.</p>
                </div>
                <div class="step-card fade-in">
                    <div class="step-number">2</div>
                    <h3>Zaplať online</h3>
                    <p>Bezpečná platba kartou během pár vteřin. Potvrzení dostaneš ihned mailem.</p>
                </div>
                <div class="step-card fade-in">
                    <div class="step-number">3</div>
                    <h3>Otevři box mobilem</h3>
                    <p>Po příchodu k boxu ho odemkneš QR kódem nebo PINem.</p>
                </div>
            </div>
        </div>
    </section>

    <section id="locations" class="locations-section">
        <div class="container-main">
            <div class="section-header fade-in">
                <span class="section-label">Kde nás najdeš</span>
                <h2>Naše lokality</h2>
            </div>
            <div class="locations-grid">
                {% for stanice_item in stanice %}
                    <div class="location-card loc-{{ loop.index }} fade-in">
                        <div class="location-bg"></div>
                        <div class="location-info">
                            <span class="location-tag">
                                <i class="fa-solid fa-location-dot"></i> {{ stanice_item.gpsPozice }}
                            </span>
                            <h3>{{ stanice_item.nazev }}</h3>
                            <p>{{ stanice_item.adresa.mesto|default('') }}, {{ stanice_item.adresa.ulice|default('') }}</p>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <section id="pricing" class="pricing-section section-light">
        <div class="container-main">
            <div class="section-header fade-in">
                <span class="section-label">Ceník</span>
                <h2>Jednoduché ceny</h2>
                <p class="section-subtitle">Bez skrytých poplatků.</p>
            </div>
            <div class="pricing-wrapper">
                <div class="pricing-grid">
                    <div class="pricing-card fade-in">
                        <h3>Základní set</h3>
                        <div class="price">150 <span>Kč/hod</span></div>
                        <ul class="pricing-features">
                            <li>Paddleboard + pádlo</li>
                            <li>Záchranná vesta</li>
                            <li>Nepromokavý vak</li>
                            <li>Pojištění vybavení</li>
                        </ul>
                        <a href="{{ path('rezervace') }}" class="cta-button" style="width:100%;text-align:center;padding:14px 28px;">Vybrat</a>
                    </div>
                    <div class="pricing-card featured fade-in">
                        <span class="featured-badge">Nejoblíbenější</span>
                        <h3>Premium set</h3>
                        <div class="price">200 <span>Kč/hod</span></div>
                        <ul class="pricing-features">
                            <li>Prémiový paddleboard</li>
                            <li>Carbon pádlo</li>
                            <li>Záchranná vesta Pro</li>
                            <li>Velký vodotěsný vak</li>
                            <li>Pojištění vybavení</li>
                        </ul>
                        <a href="{{ path('rezervace') }}" class="cta-button" style="width:100%;text-align:center;padding:14px 28px;">Vybrat</a>
                    </div>
                    <div class="pricing-card fade-in">
                        <h3>Rodinný balíček</h3>
                        <div class="price">550 <span>Kč/hod</span></div>
                        <ul class="pricing-features">
                            <li>3× paddleboard + pádlo</li>
                            <li>3× záchranná vesta</li>
                            <li>2× nepromokavý vak</li>
                            <li>Pojištění vybavení</li>
                            <li>Sleva 25%</li>
                        </ul>
                        <a href="{{ path('rezervace') }}" class="cta-button" style="width:100%;text-align:center;padding:14px 28px;">Vybrat</a>
                    </div>
                </div>
            </div>
        </div>
    </section>

{% endblock %}
